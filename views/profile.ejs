<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <link rel="stylesheet" href="/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <aside class="sidebar">
      <a href="/" class="sidebar-logo">
        <div
          style="background: white; width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; color: var(--primary-dark);">
          🌱
        </div>
        <span style="font-family: var(--font-heading); font-weight: 800; font-size: 1.25rem;">HarvestHorizon</span>
      </a>

      <nav class="sidebar-nav">
        <a href="/profile" class="sidebar-link active">
          <span class="icon">📊</span> Overview
        </a>
        <a href="/crop_prediction" class="sidebar-link">
          <span class="icon">🌾</span> Crop Prediction
        </a>
        <a href="/crop_disease_prediction" class="sidebar-link">
          <span class="icon">🔍</span> Disease Detection
        </a>
        <a href="/yield" class="sidebar-link">
          <span class="icon">📈</span> Yield Estimation
        </a>
        <a href="/weather" class="sidebar-link">
          <span class="icon">☁️</span> Weather Insights
        </a>
        <a href="/crops" class="sidebar-link">
          <span class="icon">📚</span> Crop Library
        </a>
      </nav>

      <div style="margin-top: auto; padding-top: var(--space-xl); border-top: 1px solid rgba(255,255,255,0.1);">
        <a href="/logout" class="sidebar-link" style="color: #ff8a80;">
          <span class="icon">🚪</span> Sign Out
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <header class="top-bar">
        <div>
          <h1 style="font-size: 1.75rem; margin-bottom: 4px;">Farmer Dashboard</h1>
          <p style="color: var(--text-muted); margin: 0;">Welcome back, <span id="farmer-name-greeting">Harvest
              Expert</span></p>
        </div>
        <div class="d-flex align-items-center" style="gap: 16px;">
          <div style="text-align: right;">
            <div style="font-weight: 600;" id="current-date">October 24, 2024</div>
            <div style="font-size: 0.8rem; color: var(--text-muted);" id="farmer-location-top">Amritsar, Punjab</div>
          </div>
          <div
            style="width: 48px; height: 48px; border-radius: 50%; background: #ddd; overflow: hidden; border: 2px solid white; box-shadow: var(--shadow-sm);">
            <img src="/img/profile/h.png" alt="Profile" style="width: 100%; height: 100%; object-fit: cover;"
              id="farmer-avatar">
          </div>
        </div>
      </header>

      <!-- Quick Stats -->
      <div class="grid grid-cols-4 mb-5">
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(76, 175, 80, 0.1); color: var(--secondary);">🌽</div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Active Crop</div>
            <div style="font-weight: 700;">Wheat</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(33, 150, 243, 0.1); color: #2196f3;">💧</div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Rainfall</div>
            <div style="font-weight: 700;">120mm</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(255, 152, 0, 0.1); color: #ff9800;">🌡️</div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Avg Temp</div>
            <div style="font-weight: 700;">24°C</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: rgba(156, 39, 176, 0.1); color: #9c27b0;">🏷️</div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Market Status</div>
            <div style="font-weight: 700; color: #4caf50;">High</div>
          </div>
        </div>
      </div>

      <!-- ML Tools Grid -->
      <h3 style="margin-bottom: var(--space-lg);">AI Agriculture Modules</h3>
      <div class="feature-grid">
        <div class="tool-card">
          <div class="tool-icon">🧬</div>
          <h4>Crop Advisor</h4>
          <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: var(--space-lg);">Discover the perfect
            crop for your next season based on soil NPK levels.</p>
          <a href="/crop_prediction" class="btn btn-primary w-100" style="padding: 8px;">Run Prediction</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon">🩺</div>
          <h4>Disease Scanner</h4>
          <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: var(--space-lg);">Instantly diagnose
            plant diseases by scanning leaf images with AI.</p>
          <a href="/crop_disease_prediction" class="btn btn-primary w-100" style="padding: 8px;">Launch Scanner</a>
        </div>
        <div class="tool-card">
          <div class="tool-icon">📊</div>
          <h4>Yield Forecast</h4>
          <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: var(--space-lg);">Calculate your
            estimated harvest output with climatic data metrics.</p>
          <a href="/yield" class="btn btn-primary w-100" style="padding: 8px;">Estimate Now</a>
        </div>
      </div>

      <!-- Profile & Charts -->
      <div class="charts-grid">
        <div class="card">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 style="margin: 0;">Land Wise Distribution</h4>
            <span style="font-size: 0.8rem; color: var(--text-muted);">Total Area: 15 Acres</span>
          </div>
          <div style="height: 300px;">
            <canvas id="pieChart"></canvas>
          </div>
        </div>
        <div class="card">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 style="margin: 0;">Production Trends</h4>
            <span style="font-size: 0.8rem; color: var(--text-muted);">Last 3 Samples</span>
          </div>
          <div style="height: 300px;">
            <canvas id="customChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Year HashMap View -->
      <div class="card mt-4">
        <h4 style="margin-bottom: var(--space-lg);">Field Utilization Map (Yearly)</h4>
        <div id="yearlyFieldMap" class="hashmap-dashboard">
          <!-- Grid will be populated by JS -->
        </div>
        <div class="d-flex mt-4" style="gap: 16px; font-size: 0.8rem;">
          <div class="d-flex align-items-center" style="gap: 4px;">
            <div style="width: 12px; height: 12px; border-radius: 2px; background: #e0e0e0;"></div> Empty
          </div>
          <div class="d-flex align-items-center" style="gap: 4px;">
            <div style="width: 12px; height: 12px; border-radius: 2px; background: #4caf50;"></div> Summer Crop
          </div>
          <div class="d-flex align-items-center" style="gap: 4px;">
            <div style="width: 12px; height: 12px; border-radius: 2px; background: #ff9800;"></div> Winter Crop
          </div>
          <div class="d-flex align-items-center" style="gap: 4px;">
            <div style="width: 12px; height: 12px; border-radius: 2px; background: #2196f3;"></div> Vegetables
          </div>
        </div>
      </div>
    </main>
  </div>

  <style>
    .hashmap-dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(12px, 1fr));
      gap: 4px;
    }

    .day-square {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 2px;
      background: #e0e0e0;
      cursor: pointer;
      transition: transform 0.1s;
    }

    .day-square:hover {
      transform: scale(1.5);
      z-index: 10;
    }

    .crop-summer {
      background-color: #4caf50;
    }

    .crop-winter {
      background-color: #ff9800;
    }

    .crop-vegetable {
      background-color: #2196f3;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Update Date
      const dateDisplay = document.getElementById('current-date');
      const options = { year: 'numeric', month: 'long', day: 'numeric' };
      dateDisplay.textContent = new Date().toLocaleDateString(undefined, options);

      // Mock or Fetch Data
      const setupCharts = () => {
        const ctxPie = document.getElementById("pieChart").getContext("2d");
        new Chart(ctxPie, {
          type: "doughnut",
          data: {
            labels: ["Wheat", "Vegetables", "Staples"],
            datasets: [{
              data: [70, 20, 10],
              backgroundColor: ["#1B5E20", "#4CAF50", "#8D6E63"],
              borderWidth: 0
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom' } }
          },
        });

        const ctxCustom = document.getElementById("customChart").getContext("2d");
        new Chart(ctxCustom, {
          type: "bar",
          data: {
            labels: ["Crop A", "Crop B", "Crop C"],
            datasets: [{
              label: "Production (Tonnes)",
              data: [300, 200, 100],
              backgroundColor: "#4CAF50",
              borderRadius: 8
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: { y: { beginAtZero: true } }
          },
        });
      };

      const setupHashMap = () => {
        const map = document.getElementById("yearlyFieldMap");
        for (let i = 0; i < 365; i++) {
          const day = document.createElement("div");
          day.className = "day-square";

          // Simulate some data
          if (i < 90 || i > 300) day.classList.add("crop-winter");
          else if (i > 120 && i < 240) day.classList.add("crop-summer");
          else if (i % 15 === 0) day.classList.add("crop-vegetable");

          map.appendChild(day);
        }
      };

      setupCharts();
      setupHashMap();
    });
  </script>
</body>

</html>