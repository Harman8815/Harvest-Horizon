<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .tool-container {
        max-width: 800px;
        margin: var(--space-3xl) auto;
        padding: 0 var(--space-md);
      }

      .upload-card {
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-3xl);
        box-shadow: var(--shadow-lg);
        border: 2px dashed var(--primary-light);
        text-align: center;
        transition: var(--transition);
      }

      .upload-card:hover {
        border-color: var(--primary);
        background: rgba(27, 94, 32, 0.02);
      }

      .file-input-wrapper {
        position: relative;
        margin: var(--space-xl) 0;
      }

      #image-preview {
        max-width: 100%;
        border-radius: var(--radius-md);
        margin-top: var(--space-lg);
        display: none;
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="tool-container">
      <div class="text-center mb-5">
        <h1 style="color: var(--primary-dark); margin-bottom: var(--space-sm);">AI Disease Detection</h1>
        <p style="color: var(--text-muted);">Upload a clear photo of the infected plant leaf to identify the disease and
          get treatment suggestions.</p>
      </div>

      <div class="upload-card">
        <form action="/crop_disease_predict" method="POST" enctype="multipart/form-data">
          <div style="font-size: 3rem; margin-bottom: var(--space-md);">📸</div>
          <h3>Leaf Image Upload</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Supports JPG, PNG (Max 5MB)</p>

          <div class="file-input-wrapper">
            <input type="file" id="image" name="image" class="form-input" required accept="image/*"
              style="padding: 10px;" onchange="previewImage(event)">
          </div>

          <img id="image-preview" src="#" alt="Preview">

          <div class="text-center mt-5">
            <button type="submit" class="btn btn-primary" style="padding: 14px 50px; font-size: 1.1rem;">
              Scan for Diseases 🔍
            </button>
          </div>
        </form>
      </div>

      <!-- Tips Section -->
      <div class="mt-5">
        <h4 class="mb-4">Tips for accurate results</h4>
        <div class="grid grid-cols-2">
          <div class="d-flex align-items-start" style="gap: 12px;">
            <div
              style="background: var(--primary); color: white; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; font-size: 0.75rem;">
              1</div>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Ensure the leaf is well-lit and the camera is
              focused on the infected area.</p>
          </div>
          <div class="d-flex align-items-start" style="gap: 12px;">
            <div
              style="background: var(--primary); color: white; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; font-size: 0.75rem;">
              2</div>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Capture the leaf against a neutral background to
              avoid AI model confusion.</p>
          </div>
        </div>
      </div>

      <div class="text-center mt-5">
        <a href="/profile" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">Back to
          Dashboard</a>
      </div>
    </div>

    <script>
      function previewImage(event) {
        const preview = document.getElementById('image-preview');
        const file = event.target.files[0];
        const reader = new FileReader();

        reader.onload = function () {
          preview.src = reader.result;
          preview.style.display = 'block';
        }

        if (file) {
          reader.readAsDataURL(file);
        }
      }
    </script>

    <%- include('partials/footer') %>
</body>

</html>