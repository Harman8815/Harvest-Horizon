<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .weather-container {
        min-height: calc(100vh - 80px);
        padding: var(--space-3xl) 0;
        background: radial-gradient(circle at top right, #e3f2fd, var(--background));
      }

      .search-area {
        max-width: 800px;
        margin: 0 auto var(--space-3xl);
      }

      .weather-hero-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3xl);
        align-items: center;
        margin-bottom: var(--space-3xl);
      }

      .weather-card-hero {
        background: linear-gradient(135deg, var(--primary) 0%, #2e7d32 100%);
        border-radius: var(--radius-xl);
        padding: var(--space-3xl);
        color: white;
        box-shadow: var(--shadow-lg);
        position: relative;
        overflow: hidden;
        display: none;
        /* Shown after fetch */
      }

      .weather-card-hero::before {
        content: '';
        position: absolute;
        top: -50px;
        right: -50px;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
      }

      .stat-box {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        padding: var(--space-lg);
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
      }

      #loading-overlay {
        display: none;
        text-align: center;
        padding: var(--space-2xl);
      }

      .weather-illustration {
        width: 150px;
        height: 150px;
        margin: 0 auto var(--space-lg);
      }

      .popular-cities {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: var(--space-lg);
        margin-top: var(--space-2xl);
      }

      .city-pill {
        background: white;
        padding: var(--space-md);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        transition: var(--transition);
        text-align: center;
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .city-pill:hover {
        transform: translateY(-5px);
        border-color: var(--primary);
        box-shadow: var(--shadow-md);
      }
    </style>
</head>

<body>
  <%- include('partials/navbar') %>

    <div class="weather-container">
      <div class="container">
        <div class="search-area">
          <div class="weather-hero-layout d-none d-lg-grid">
            <div>
              <h1 class="display-4 font-bold mb-3" style="color: var(--primary-dark);">Climate Radar</h1>
              <p class="text-muted lead">Track localized atmospheric data across the globe. Our weather models process
                real-time satellite telemetry for agricultural precision.</p>
            </div>
            <div class="text-center">
              <div
                style="background: white; padding: var(--space-xl); border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);">
                <div class="d-flex" style="gap: 12px; margin-bottom: 20px;">
                  <input type="text" id="city" class="form-input" placeholder="Enter City (e.g. New Delhi)"
                    style="flex: 1;">
                </div>
                <div class="d-flex" style="gap: 12px;">
                  <input type="text" id="country" class="form-input" placeholder="Country (e.g. India)"
                    style="flex: 1;">
                  <button onclick="getWeather()" class="btn btn-primary" style="padding: 12px 30px;">Analyze</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile Only Search -->
          <div class="d-lg-none text-center mb-5">
            <h1>Climate Radar</h1>
            <div class="card mt-4">
              <input type="text" id="city-mob" class="form-input mb-3" placeholder="City">
              <input type="text" id="country-mob" class="form-input mb-3" placeholder="Country">
              <button onclick="getWeather(true)" class="btn btn-primary w-100">Analyze Sky</button>
            </div>
          </div>
        </div>

        <div id="loading-overlay">
          <div class="spinner mx-auto mb-3"></div>
          <p>Establishing Satellite Connection...</p>
        </div>

        <div id="weather-result" class="weather-card-hero">
          <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start">
              <div class="d-flex align-items-center mb-3" style="gap: 12px;">
                <span style="font-size: 2.5rem;">📡</span>
                <div>
                  <h2 id="location-name" style="color: white; margin: 0; font-family: var(--font-heading);">Location
                  </h2>
                  <span id="location-country" style="opacity: 0.8; font-weight: 600;">Country</span>
                </div>
              </div>
              <h1 id="temp-display"
                style="font-size: 6rem; color: white; margin-bottom: 0; font-family: var(--font-heading); font-weight: 800;">
                --°C</h1>
              <p id="desc-display" class="lead text-capitalize" style="opacity: 0.9; font-weight: 500;">Weather
                description</p>
            </div>
            <div class="col-md-6 text-center">
              <img src="/img/weathericons/sun.svg" id="weather-icon" class="weather-illustration" alt="Weather"
                style="filter: drop-shadow(0 0 20px rgba(255,255,255,0.3));">
            </div>
          </div>

          <div class="grid grid-cols-4 mt-5">
            <div class="stat-box">
              <small style="opacity: 0.8; font-weight: 700; font-size: 0.7rem; letter-spacing: 1px;">FEELS LIKE</small>
              <h3 id="feels-like" style="color: white; margin-top: 5px;">--°C</h3>
            </div>
            <div class="stat-box">
              <small style="opacity: 0.8; font-weight: 700; font-size: 0.7rem; letter-spacing: 1px;">HUMIDITY</small>
              <h3 id="humidity" style="color: white; margin-top: 5px;">--%</h3>
            </div>
            <div class="stat-box">
              <small style="opacity: 0.8; font-weight: 700; font-size: 0.7rem; letter-spacing: 1px;">WIND SPEED</small>
              <h3 id="wind-speed" style="color: white; margin-top: 5px;">-- m/s</h3>
            </div>
            <div class="stat-box">
              <small style="opacity: 0.8; font-weight: 700; font-size: 0.7rem; letter-spacing: 1px;">COORDINATES</small>
              <h3 id="coords" style="color: white; font-size: 0.9rem; margin-top: 5px;">--</h3>
            </div>
          </div>
        </div>

        <div id="initial-view">
          <h4 class="mb-4" style="color: var(--primary-dark);">Recommended for Monitoring</h4>
          <div class="popular-cities">
            <div class="city-pill" onclick="quickLook('Gwalior', 'India')">
              <div style="font-size: 1.5rem; margin-bottom: 5px;">🏢</div>
              <strong>Gwalior</strong><br><small class="text-muted">India</small>
            </div>
            <div class="city-pill" onclick="quickLook('London', 'UK')">
              <div style="font-size: 1.5rem; margin-bottom: 5px;">🇬🇧</div>
              <strong>London</strong><br><small class="text-muted">UK</small>
            </div>
            <div class="city-pill" onclick="quickLook('New York', 'USA')">
              <div style="font-size: 1.5rem; margin-bottom: 5px;">🗽</div>
              <strong>New York</strong><br><small class="text-muted">USA</small>
            </div>
            <div class="city-pill" onclick="quickLook('Tokyo', 'Japan')">
              <div style="font-size: 1.5rem; margin-bottom: 5px;">🗼</div>
              <strong>Tokyo</strong><br><small class="text-muted">Japan</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      async function quickLook(city, country) {
        document.getElementById('city').value = city;
        document.getElementById('country').value = country;
        getWeather();
      }

      async function getWeather(isMobile = false) {
        const city = isMobile ? document.getElementById('city-mob').value.trim() : document.getElementById('city').value.trim();
        const country = isMobile ? document.getElementById('country-mob').value.trim() : document.getElementById('country').value.trim();

        if (!city || !country) return alert('Please enter both city and country');

        const resultDiv = document.getElementById('weather-result');
        const loader = document.getElementById('loading-overlay');
        const initialView = document.getElementById('initial-view');

        resultDiv.style.display = 'none';
        initialView.style.display = 'none';
        loader.style.display = 'block';

        try {
          const response = await fetch(`/getweather?city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}`);
          const data = await response.json();

          if (data.error) {
            alert(data.error);
            initialView.style.display = 'block';
          } else {
            document.getElementById('location-name').innerText = data.name;
            document.getElementById('location-country').innerText = data.sys.country;
            document.getElementById('temp-display').innerText = `${Math.round(data.main.temp)}°C`;
            document.getElementById('desc-display').innerText = data.weather[0].description;
            document.getElementById('feels-like').innerText = `${Math.round(data.main.feels_like)}°C`;
            document.getElementById('humidity').innerText = `${data.main.humidity}%`;
            document.getElementById('wind-speed').innerText = `${data.wind.speed} m/s`;
            document.getElementById('coords').innerText = `${data.coord.lat.toFixed(2)}, ${data.coord.lon.toFixed(2)}`;
            document.getElementById('weather-icon').src = `/img/weathericons/${data.icon}`;

            resultDiv.style.display = 'block';
            gsap.from(resultDiv, { opacity: 0, y: 30, duration: 0.6, ease: "power2.out" });
          }
        } catch (error) {
          alert('Connection error. Please try again.');
          initialView.style.display = 'block';
        } finally {
          loader.style.display = 'none';
        }
      }
    </script>

    <%- include('partials/footer') %>
</body>

</html>