<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(249, 251, 247, 0.9), rgba(249, 251, 247, 0.9)), url('/home.webp');
        background-size: cover;
        background-position: center;
        padding: var(--space-xl);
      }

      .auth-card {
        background: white;
        padding: var(--space-2xl);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        width: 100%;
        max-width: 450px;
        border: 1px solid rgba(0, 0, 0, 0.05);
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="auth-wrapper">
      <div class="auth-card">
        <div class="text-center mb-5">
          <h1 style="color: var(--primary-dark); font-family: var(--font-heading); margin-bottom: 8px;">Welcome Back
          </h1>
          <p style="color: var(--text-muted);">Log in to access your farm dashboard</p>
        </div>

        <form action="/signin" method="POST">
          <div class="form-group">
            <label class="form-label">Username</label>
            <input type="text" name="username" class="form-input" placeholder="Enter your username" required>
          </div>
          <div class="form-group">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-input" placeholder="••••••••" required>
          </div>

          <button type="submit" class="btn btn-primary w-100 mt-4" style="padding: 12px; font-size: 1.1rem;">
            Sign In
          </button>

          <div class="text-center mt-5">
            <p style="color: var(--text-muted); font-size: 0.9rem;">
              Don't have an account? <a href="/signup"
                style="color: var(--primary); font-weight: 700; text-decoration: none;">Create One</a>
            </p>
            <div class="mt-3">
              <a href="/" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">← Back to
                Home</a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <%- include('partials/footer') %>
</body>

</html>