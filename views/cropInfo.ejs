<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .report-header {
        background: linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)), url('/img/<%= crop.image %>');
        background-size: cover;
        background-position: center;
        height: 400px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        text-align: center;
        margin-bottom: var(--space-3xl);
        text-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
      }

      .report-container {
        max-width: 1000px;
        margin: -100px auto var(--space-3xl);
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-3xl);
        box-shadow: var(--shadow-xl);
        position: relative;
        z-index: 10;
      }

      .info-section {
        margin-bottom: var(--space-2xl);
        padding-bottom: var(--space-xl);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }

      .info-section:last-child {
        border-bottom: none;
      }

      .section-title {
        color: var(--primary);
        font-family: var(--font-heading);
        margin-bottom: var(--space-md);
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-title::before {
        content: '';
        width: 4px;
        height: 24px;
        background: var(--secondary);
        border-radius: 2px;
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="report-header">
      <div class="container">
        <span style="text-transform: uppercase; letter-spacing: 2px; font-weight: 700; color: var(--secondary);">Crop
          Profile</span>
        <h1 class="display-3 font-bold text-yellow-300 mt-2"
          style="font-family: var(--font-heading); color: var(--secondary-light);">
          <%= crop.name %>
        </h1>
        <p class="lead opacity-80" style="max-width: 600px; margin: 0 auto;">
          <%= crop.description %>
        </p>
      </div>
    </div>

    <div class="report-container">
      <div class="grid grid-cols-3 mb-5" style="gap: var(--space-xl);">
        <div class="card text-center" style="padding: var(--space-md);">
          <span class="text-muted d-block mb-1" style="font-size: 0.8rem;">Category</span>
          <strong style="color: var(--primary-dark);">
            <%= crop.type %>
          </strong>
        </div>
        <div class="card text-center" style="padding: var(--space-md);">
          <span class="text-muted d-block mb-1" style="font-size: 0.8rem;">Scientific Name</span>
          <strong style="color: var(--primary-dark); font-style: italic;">
            <%= crop.scientificName %>
          </strong>
        </div>
        <div class="card text-center" style="padding: var(--space-md);">
          <span class="text-muted d-block mb-1" style="font-size: 0.8rem;">Status</span>
          <strong style="color: var(--secondary);">High Yield</strong>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Overview</h3>
        <p style="line-height: 1.8; color: var(--text-muted);">
          <%= crop.info.overview %>
        </p>
      </div>

      <div class="grid grid-cols-2" style="gap: var(--space-2xl);">
        <div class="info-section">
          <h3 class="section-title">Soil Requirements</h3>
          <ul class="list-unstyled">
            <% crop.info.soilRequirements.forEach(function(item) { %>
              <li class="mb-2 d-flex align-items-start" style="gap: 8px;">
                <span style="color: var(--secondary);">●</span>
                <span style="color: var(--text-muted);">
                  <%= item %>
                </span>
              </li>
              <% }); %>
          </ul>
        </div>
        <div class="info-section">
          <h3 class="section-title">Climate & Rainfall</h3>
          <ul class="list-unstyled">
            <% crop.info.climateAndRainfall.forEach(function(item) { %>
              <li class="mb-2 d-flex align-items-start" style="gap: 8px;">
                <span style="color: var(--secondary);">●</span>
                <span style="color: var(--text-muted);">
                  <%= item %>
                </span>
              </li>
              <% }); %>
          </ul>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Cultivation Methods</h3>
        <div class="grid grid-cols-3" style="gap: var(--space-lg);">
          <div class="card" style="background: rgba(27, 94, 32, 0.02); border: none;">
            <h6>Planting</h6>
            <ul class="list-unstyled small text-muted">
              <% crop.info.plantingMethods.forEach(item=> { %> <li>- <%= item %>
                </li>
                <% }) %>
            </ul>
          </div>
          <div class="card" style="background: rgba(27, 94, 32, 0.02); border: none;">
            <h6>Watering</h6>
            <ul class="list-unstyled small text-muted">
              <% crop.info.waterManagement.forEach(item=> { %> <li>- <%= item %>
                </li>
                <% }) %>
            </ul>
          </div>
          <div class="card" style="background: rgba(27, 94, 32, 0.02); border: none;">
            <h6>Feeding</h6>
            <ul class="list-unstyled small text-muted">
              <% crop.info.fertilization.forEach(item=> { %> <li>- <%= item %>
                </li>
                <% }) %>
            </ul>
          </div>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Harvesting & Management</h3>
        <div style="background: var(--surface); padding: var(--space-lg); border-radius: var(--radius-md);">
          <p><strong>Pest Control:</strong>
            <%= crop.info.pestAndDiseaseManagement.join(", ") %></p>
                <p><strong>Harvesting:</strong> <%= crop.info.harvesting.join(" , ") %></p>
                <p class=" mb-0"><strong>Post-Harvest:</strong>
              <%= crop.info.postHarvestManagement.join(", ") %></p>
            </div>
        </div>

        <div class=" info-section">
                <h3 class="section-title">Conclusion</h3>
                <p style="font-style: italic; color: var(--text-muted);">
                  <%= crop.info.conclusion %>
                </p>
        </div>

        <div class="text-center mt-5">
          <a href="/crops" class="btn btn-primary" style="padding: 12px 40px;">← Back to Encyclopedia</a>
        </div>
      </div>

      <%- include('partials/footer') %>
</body>

</html>