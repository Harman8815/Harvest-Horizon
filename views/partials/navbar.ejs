                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path
                        d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 3.5 2 7a7 7 0 0 1-7 7c-.7 0-1.38-.1-2-.3">
                    </path>
                    <path d="M7 20c-1.57 0-3-1.43-3-3s1.43-3 3-3 3 1.43 3 3-1.43 3-3 3z"></path>
                    <path d="M10 20c2 0 4-2 4-4s-2-4-4-4-4 2-4 4 2 4 4 4z"></path>
                </svg>
            </div>
            <span
                style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--primary); letter-spacing: -0.5px;">HarvestHorizon</span>
        </a>

        <div class="navbar-links d-none d-lg-flex align-items-center">
            <a href="/" class="nav-link">Home</a>
