<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

  <body>
    <!-- Page Loader -->
    <div class="page-loader" id="loader">
      <div class="spinner"></div>
    </div>

    <%- include('partials/navbar') %>

      <!-- Hero Section -->
      <section class="hero-section"
        style="padding: var(--space-3xl) 0; background: radial-gradient(circle at top right, #e8f5e9 0%, var(--background) 50%); overflow: hidden;">
        <div class="container grid grid-cols-2 align-items-center" style="min-height: 80vh;">
          <div class="hero-content animate-fade">
            <span
              style="color: var(--secondary); font-weight: 700; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; display: block; margin-bottom: var(--space-md);">
              Sustainable Farming Solutions
            </span>
            <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; margin-bottom: var(--space-lg);">
              The Future of <span style="color: var(--primary);">Agriculture</span> is Intelligent.
            </h1>
            <p style="font-size: 1.2rem; color: var(--text-muted); margin-bottom: var(--space-xl); max-width: 500px;">
              Predict crops, detect diseases, and estimate yields with our advanced ML-powered platform. empowering
              farmers with data-driven insights.
            </p>
            <div class="d-flex" style="gap: var(--space-md);">
              <a href="/profile" class="btn btn-primary">Get Started</a>
              <a href="#services" class="btn btn-outline" style="background: white;">Explore Tools</a>
            </div>

            <div class="stats-preview d-flex mt-5" style="gap: var(--space-xl);">
              <div>
                <h3 style="margin: 0; color: var(--primary);">98%</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Accuracy rate</p>
              </div>
              <div style="width: 1px; background: #ddd;"></div>
              <div>
                <h3 style="margin: 0; color: var(--primary);">5k+</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0;">Active farmers</p>
              </div>
            </div>
          </div>
          <div class="hero-image d-none d-lg-block" style="position: relative;">
            <div
              style="background: var(--primary); width: 100%; height: 500px; border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; overflow: hidden; box-shadow: var(--shadow-lg);">
              <img src="/homer.png" alt="Agriculture Tech"
                style="width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; opacity: 0.8;">
            </div>
            <!-- Floating Glass Cards -->
            <div class="glass"
              style="position: absolute; bottom: 40px; left: -20px; padding: 20px; border-radius: 16px; width: 220px; box-shadow: var(--shadow-lg);">
              <h5 style="margin: 0; font-size: 0.9rem;">Soil Health Alert</h5>
              <p style="margin: 5px 0 0; font-size: 0.75rem; color: var(--text-muted);">Nitrogen levels optimal for
                Rice.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Weather Insights Section -->
      <section id="weather" style="padding: var(--space-3xl) 0; border-bottom: 1px solid #eee;">
        <div class="container">
          <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
              <h2 style="margin-bottom: var(--space-sm);">Climate Radar</h2>
              <p style="color: var(--text-muted); margin: 0;">Real-time weather analytics for precise farm management.
              </p>
            </div>
            <a href="/weather" class="btn btn-outline">Check Local Climate</a>
          </div>

          <div class="grid grid-cols-3">
            <% weatherDataArray.forEach((weatherData, index)=> { %>
              <div class="card weather-summary-card">
                <div class="d-flex justify-content-between align-items-start mb-4">
                  <div>
                    <h4 style="margin: 0;">
                      <%= weatherData.name %>
                    </h4>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">
                      <%= weatherData.sys.country %>
                    </span>
                  </div>
                  <img src="/img/weathericons/<%= weatherData.icon %>" alt="weather" style="width: 48px;">
                </div>
                <div style="font-size: 2.5rem; font-weight: 700; color: var(--primary); margin-bottom: 8px;">
                  <%= Math.round(weatherData.main.temp) %>°C
                </div>
                <p style="color: var(--text-muted); text-transform: capitalize; margin-bottom: var(--space-lg);">
                  <%= weatherData.weather[0].description %>
                </p>
                <div class="grid grid-cols-2"
                  style="background: var(--background); padding: 12px; border-radius: 12px; font-size: 0.85rem;">
                  <div>
                    <div style="color: var(--text-muted);">Humidity</div>
                    <div style="font-weight: 600;">
                      <%= weatherData.main.humidity %>%
                    </div>
                  </div>
                  <div>
                    <div style="color: var(--text-muted);">Wind</div>
                    <div style="font-weight: 600;">
                      <%= weatherData.wind.speed %> m/s
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>
          </div>
        </div>
      </section>

      <!-- Services / ML Tools -->
      <section id="services" style="padding: var(--space-3xl) 0; background-color: #f6f9f6;">
        <div class="container">
          <div class="text-center mb-5">
            <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.8rem;">Core
              Modules</span>
            <h2 style="margin-top: 10px; margin-bottom: var(--space-sm);">Precision AI Tools</h2>
            <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto;">Our specialized ML modules analyze
              billions of data points to secure your harvest.</p>
          </div>

          <div class="grid grid-cols-3" id="tool-grid">
            <!-- Tool 1 -->
            <div class="card service-card"
              style="padding: 0; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
              <div style="height: 220px; overflow: hidden; position: relative;">
                <img src="/img/services/soil.jpg" alt="Crop Prediction"
                  style="width: 100%; height: 100%; object-fit: cover;">
                <div
                  style="position: absolute; top: 20px; right: 20px; background: var(--primary); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 700;">
                  SOIL AI</div>
              </div>
              <div style="padding: var(--space-xl);">
                <h4 style="margin-bottom: var(--space-sm);">Crop Recommendation</h4>
                <p
                  style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: var(--space-xl);">
                  Targeted analysis of Nitrogen, Phosphorus, and Potassium levels to predict the highest yielding crops.
                </p>
                <a href="/crop_prediction" class="btn btn-primary w-100">Start Prediction →</a>
              </div>
            </div>

            <!-- Tool 2 -->
            <div class="card service-card"
              style="padding: 0; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
              <div style="height: 220px; overflow: hidden; position: relative;">
                <img src="/img/services/disease.jpg" alt="Disease Detection"
                  style="width: 100%; height: 100%; object-fit: cover;">
                <div
                  style="position: absolute; top: 20px; right: 20px; background: #d32f2f; color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 700;">
                  VISION AI</div>
              </div>
              <div style="padding: var(--space-xl);">
                <h4 style="margin-bottom: var(--space-sm);">Disease Detection</h4>
                <p
                  style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: var(--space-xl);">
                  Instant computer vision analysis of leaf patterns to identify 30+ types of agricultural diseases.
                </p>
                <a href="/crop_disease_prediction" class="btn btn-primary w-100">Scan Leaves →</a>
              </div>
            </div>

            <!-- Tool 3 -->
            <div class="card service-card"
              style="padding: 0; overflow: hidden; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
              <div style="height: 220px; overflow: hidden; position: relative;">
                <img src="/img/services/cost.jpg" alt="Yield Estimation"
                  style="width: 100%; height: 100%; object-fit: cover;">
                <div
                  style="position: absolute; top: 20px; right: 20px; background: var(--secondary); color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.7rem; font-weight: 700;">
                  FORECAST AI</div>
              </div>
              <div style="padding: var(--space-xl);">
                <h4 style="margin-bottom: var(--space-sm);">Yield Estimation</h4>
                <p
                  style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: var(--space-xl);">
                  Advanced forecasting models using historical rainfall and temperature data to project your harvest.
                </p>
                <a href="/yield" class="btn btn-primary w-100">Forecast Yield →</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: Why Farmers Trust Us -->
      <section style="padding: var(--space-3xl) 0;">
        <div class="container">
          <div class="row align-items-center">
            <div class="col-lg-5">
              <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.8rem;">Our
                Value Proposition</span>
              <h2 class="display-5 mb-4 mt-2">The Digital Backbone of <span style="color: var(--primary);">Modern
                  Farming</span></h2>
              <p class="text-muted mb-5">We provide the most comprehensive AI ecosystem for agriculture, from soil to
                silo. Our platform is built by agronomists and AI researchers.</p>

              <div style="display: grid; gap: 24px;">
                <div class="d-flex" style="gap: 16px;">
                  <div
                    style="font-size: 1.5rem; background: #e8f5e9; width: 50px; height: 50px; border-radius: 12px; display: grid; place-items: center;">
                    📉</div>
                  <div>
                    <h5 class="mb-1">Maximize ROI</h5>
                    <p class="small text-muted mb-0">Increase yield by up to 35% through precision fertilization and
                      irrigation plans.</p>
                  </div>
                </div>
                <div class="d-flex" style="gap: 16px;">
                  <div
                    style="font-size: 1.5rem; background: #fff3e0; width: 50px; height: 50px; border-radius: 12px; display: grid; place-items: center;">
                    🌍</div>
                  <div>
                    <h5 class="mb-1">Climate Resilience</h5>
                    <p class="small text-muted mb-0">Stay ahead of erratic weather patterns with localized atmospheric
                      radar data.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-7">
              <div class="row g-4 ps-lg-5">
                <div class="col-sm-6">
                  <div class="card h-100 p-4 border-0"
                    style="background: var(--surface); box-shadow: var(--shadow-lg);">
                    <h3 style="color: var(--primary);">10k+</h3>
                    <p class="text-muted mb-2 font-bold">Hectares Under AI Control</p>
                    <p class="small text-muted">Across 5 countries, our AI manages vast agricultural lands for
                      sustainable growth.</p>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="card h-100 p-4 border-0"
                    style="background: var(--primary); color: white; margin-top: 30px;">
                    <h3 style="color: var(--secondary-light);">98%</h3>
                    <p class="mb-2 font-bold" style="color: white; opacity: 0.9;">Prediction Accuracy</p>
                    <p class="small" style="color: white; opacity: 0.7;">Verified by independent field trials and farmer
                      feedback across diverse soil types.</p>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="card h-100 p-4 border-0" style="background: var(--secondary); color: white;">
                    <h3 style="color: white;">24/7</h3>
                    <p class="mb-2 font-bold" style="color: white; opacity: 0.9;">Satellite Monitoring</p>
                    <p class="small" style="color: white; opacity: 0.7;">Real-time ground and sky telemetry processed
                      every 15 minutes by our cloud neural net.</p>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="card h-100 p-4 border-0"
                    style="background: var(--surface); box-shadow: var(--shadow-lg); margin-top: 30px;">
                    <h3>30+</h3>
                    <p class="text-muted mb-2 font-bold">Infectious Agents Profiled</p>
                    <p class="small text-muted">A comprehensive database of pests and fungal diseases localized for your
                      specific crop types.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Our Team Section -->
      <section id="team"
        style="padding: var(--space-3xl) 0; background: var(--background); border-top: 1px solid #eee;">
        <div class="container">
          <div class="text-center mb-5">
            <span style="color: var(--primary); font-weight: 700; text-transform: uppercase; font-size: 0.8rem;">The
              Innovators</span>
            <h2 style="margin-top: 10px;">The Minds Behind the Horizon</h2>
            <p style="color: var(--text-muted);">Combining expertise in Machine Learning, Data Science, and Agronomy.
            </p>
          </div>
          <div class="grid grid-cols-2" style="max-width: 900px; margin: 0 auto;">
            <div class="team-card-wrapper">
              <div class="card text-center team-card">
                <div style="position: relative; width: 151px; height: 151px; margin: 0 auto var(--space-lg);">
                  <div
                    style="position: absolute; top:0; left:0; width:100%; height:100%; border: 3px solid var(--primary); border-radius: 50%; border-style: dashed; animation: rotate 10s linear infinite;">
                  </div>
                  <img src="/img/profile/h.png" alt="Harman"
                    style="width: 140px; height: 140px; border-radius: 50%; object-fit: cover; margin: 5px;">
                </div>
                <h4 class="mb-1">Harman Deep Singh</h4>
                <p style="color: var(--secondary); font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">
                  FrontEnd Developer & AI Architect</p>
                <p style="color: var(--text-muted); font-size: 0.85rem;">Full-stack web Developer focus on responsive
                  designs.</p>
              </div>
            </div>
            <div class="team-card-wrapper">
              <div class="card text-center team-card">
                <div style="position: relative; width: 151px; height: 151px; margin: 0 auto var(--space-lg);">
                  <div
                    style="position: absolute; top:0; left:0; width:100%; height:100%; border: 3px solid var(--secondary); border-radius: 50%; border-style: dashed; animation: rotate 10s linear reverse infinite;">
                  </div>
                  <img src="/img/profile/m.png" alt="Manav"
                    style="width: 140px; height: 140px; border-radius: 50%; object-fit: cover; margin: 5px;">
                </div>
                <h4 class="mb-1">Manav Gupta</h4>
                <p style="color: var(--secondary); font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">
                  Data Scientist & Researcher</p>
                <p style="color: var(--text-muted); font-size: 0.85rem;">Expert in predictive analytics and dataset
                  curation with focus on localized farming outcomes.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <%- include('partials/footer') %>

        <script>
          window.addEventListener('load', () => {
            const loader = document.getElementById('loader');
            if (loader) {
              loader.style.opacity = '0';
              setTimeout(() => {
                loader.style.display = 'none';
                ScrollTrigger.refresh();
              }, 500);
            }
          });

          gsap.registerPlugin(ScrollTrigger);

          // Hero Animation
          gsap.from(".hero-content > *", {
            opacity: 0,
            x: -30,
            duration: 1,
            stagger: 0.2,
            ease: "expo.out"
          });

          // Service Cards - More robust entry
          gsap.utils.toArray(".service-card").forEach((card, i) => {
            gsap.from(card, {
              scrollTrigger: {
                trigger: card,
                start: "top 95%",
                toggleActions: "play none none none",
                once: true // Only animate once
              },
              opacity: 0,
              y: 40,
              scale: 0.98,
              duration: 0.8,
              delay: i * 0.1, // Stagger based on index if multiple visible
              ease: "power2.out",
              onComplete: () => {
                card.style.transform = "none"; // Clean up after animation
              }
            });
          });

          // Team Card animations - more robust
          gsap.utils.toArray(".team-card").forEach((card, i) => {
            gsap.from(card, {
              scrollTrigger: {
                trigger: card,
                start: "top 90%",
                toggleActions: "play none none none"
              },
              opacity: 0,
              y: 40,
              scale: 0.95,
              duration: 1,
              delay: i * 0.1,
              ease: "power3.out"
            });
          });

          // Team image rotation style
          const style = document.createElement('style');
          style.textContent = `
            @keyframes rotate {
                from { transform: rotate(0deg); }
                to { transform: rotate(360deg); }
            }
          `;
          document.head.append(style);
        </script>
  </body>

</html>