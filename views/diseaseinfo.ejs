<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .disease-header {
        background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
        padding: var(--space-3xl) 0;
        color: white;
        text-align: center;
      }

      .report-container {
        max-width: 1000px;
        margin: var(--space-3xl) auto;
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-3xl);
        box-shadow: var(--shadow-xl);
        border: 1px solid rgba(0, 0, 0, 0.05);
      }

      .info-section {
        margin-bottom: var(--space-2xl);
        padding-bottom: var(--space-xl);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      }

      .info-section:last-child {
        border-bottom: none;
      }

      .section-title {
        color: #b71c1c;
        font-family: var(--font-heading);
        margin-bottom: var(--space-md);
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-title::before {
        content: '';
        width: 4px;
        height: 24px;
        background: #ff5252;
        border-radius: 2px;
      }

      .tag {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-right: 8px;
        background: rgba(211, 47, 47, 0.1);
        color: #b71c1c;
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="disease-header">
      <div class="container">
        <span style="text-transform: uppercase; letter-spacing: 2px; font-weight: 700; opacity: 0.8;">Diagnosis
          Result</span>
        <h1 class="display-3 font-bold mt-2" style="font-family: var(--font-heading);">
          <%= crop.disease_name %>
        </h1>
        <p class="lead opacity-80" style="font-style: italic;">
          <%= crop.scientific_name %>
        </p>
      </div>
    </div>

    <div class="report-container">
      <div class="grid grid-cols-2 mb-5" style="gap: var(--space-xl);">
        <div class="card" style="padding: var(--space-lg); border-left: 5px solid #d32f2f;">
          <h6 style="color: #d32f2f;">Primary Symptoms</h6>
          <div class="mt-2">
            <% crop.symptoms.forEach(symp=> { %>
              <span class="tag">
                <%= symp %>
              </span>
              <% }) %>
          </div>
        </div>
        <div class="card" style="padding: var(--space-lg); border-left: 5px solid var(--primary);">
          <h6 style="color: var(--primary);">Host Crops</h6>
          <div class="mt-2">
            <% crop.host_crops.forEach(host=> { %>
              <span class="tag" style="background: rgba(27, 94, 32, 0.1); color: var(--primary);">
                <%= host %>
              </span>
              <% }) %>
          </div>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Overview & Disease Cycle</h3>
        <p style="line-height: 1.8; color: var(--text-muted);">
          <%= crop.disease_cycle %>
        </p>
      </div>

      <div class="grid grid-cols-2" style="gap: var(--space-2xl);">
        <div class="info-section">
          <h3 class="section-title">Risk Factors</h3>
          <ul class="list-unstyled">
            <% crop.environmental_conditions.forEach(function(item) { %>
              <li class="mb-2 d-flex align-items-start" style="gap: 8px;">
                <span style="color: #ff5252;">⚠️</span>
                <span style="color: var(--text-muted);">
                  <%= item %>
                </span>
              </li>
              <% }); %>
          </ul>
        </div>
        <div class="info-section">
          <h3 class="section-title">Transmission</h3>
          <p style="color: var(--text-muted);">
            <%= crop.transmission %>
          </p>
          <div
            style="background: var(--surface); padding: var(--space-md); border-radius: var(--radius-md); margin-top: var(--space-md);">
            <small><strong>Geographic Note:</strong>
              <%= crop.geographic_distribution %>
            </small>
          </div>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Management Strategies</h3>
        <div class="card" style="background: #fff9f9; border: 1px solid #ffebee;">
          <div class="grid grid-cols-2" style="gap: var(--space-lg); padding: var(--space-lg);">
            <div>
              <h6 style="color: #b71c1c;">Active Control</h6>
              <ul class="list-unstyled small text-muted">
                <% crop.management_strategies.forEach(item=> { %> <li>- <%= item %>
                  </li>
                  <% }) %>
              </ul>
            </div>
            <div>
              <h6 style="color: #b71c1c;">Treatment/Cure</h6>
              <ul class="list-unstyled small text-muted">
                <% crop.treatment_or_cure.forEach(item=> { %> <li>- <%= item %>
                  </li>
                  <% }) %>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Prevention Tips</h3>
        <div class="grid grid-cols-2" style="gap: var(--space-md);">
          <% crop.prevention_tips.forEach(tip=> { %>
            <div class="d-flex align-items-center mb-2"
              style="gap: 12px; background: rgba(27, 94, 32, 0.05); padding: 12px; border-radius: var(--radius-md);">
              <span style="color: var(--primary);">🛡️</span>
              <span style="font-size: 0.9rem; color: var(--primary-dark);">
                <%= tip %>
              </span>
            </div>
            <% }) %>
        </div>
      </div>

      <div class="info-section">
        <h3 class="section-title">Economic Impact</h3>
        <p style="font-style: italic; color: #b71c1c;">
          <%= crop.economic_importance %>
        </p>
      </div>

      <div class="text-center mt-5">
        <a href="/profile" class="btn btn-primary" style="padding: 12px 40px;">Return to Dashboard</a>
      </div>
    </div>

    <%- include('partials/footer') %>
</body>

</html>