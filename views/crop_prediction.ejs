<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .tool-container {
        max-width: 800px;
        margin: var(--space-3xl) auto;
        padding: 0 var(--space-md);
      }

      .form-card {
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-2xl);
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(0, 0, 0, 0.05);
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="tool-container">
      <div class="text-center mb-5">
        <h1 style="color: var(--primary-dark); margin-bottom: var(--space-sm);">Crop Recommendation</h1>
        <p style="color: var(--text-muted);">Fill in the soil and climate details to get the most suitable crop
          recommendation for your farm.</p>
      </div>

      <div class="form-card">
        <form action="/predict" method="POST">
          <div class="grid grid-cols-2">
            <div class="form-group">
              <label class="form-label">Nitrogen (N)</label>
              <input type="number" name="Nitrogen" class="form-input" placeholder="e.g. 90" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Phosphorus (P)</label>
              <input type="number" name="P" class="form-input" placeholder="e.g. 42" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Potassium (K)</label>
              <input type="number" name="K" class="form-input" placeholder="e.g. 43" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Temperature (°C)</label>
              <input type="number" name="temperature" class="form-input" placeholder="e.g. 20.8" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Humidity (%)</label>
              <input type="number" name="humidity" class="form-input" placeholder="e.g. 82.0" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">pH Level</label>
              <input type="number" name="ph" class="form-input" placeholder="e.g. 6.5" required step="any">
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">Rainfall (mm)</label>
            <input type="number" name="rainfall_In_mm" class="form-input" placeholder="e.g. 202.9" required step="any">
          </div>

          <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary" style="padding: 14px 40px; font-size: 1.1rem;">
              Analyze Soil & Predict 🌾
            </button>
            <div style="margin-top: var(--space-md);">
              <a href="/profile" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">Back to
                Dashboard</a>
            </div>
          </div>
        </form>
      </div>

      <!-- Info Section -->
      <div class="mt-5 grid grid-cols-2" style="gap: var(--space-xl);">
        <div class="card" style="background: rgba(27, 94, 32, 0.05); border: none;">
          <h5 style="color: var(--primary);">How it works?</h5>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Our Random Forest ML model analyzes 7
            distinct soil and environmental parameters to match your conditions with the ideal crop profile with 98%
            accuracy.</p>
        </div>
        <div class="card" style="background: rgba(141, 110, 99, 0.05); border: none;">
          <h5 style="color: var(--accent);">Why soil NPK?</h5>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">Nitrogen, Phosphorus, and Potassium are
            the primary nutrients required by plants. Knowing their concentration helps in choosing crops that will
            thrive in your specific soil.</p>
        </div>
      </div>
    </div>

    <%- include('partials/footer') %>
</body>

</html>