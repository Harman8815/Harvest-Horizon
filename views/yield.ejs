<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head') %>
    <style>
      .tool-container {
        max-width: 800px;
        margin: var(--space-3xl) auto;
        padding: 0 var(--space-md);
      }

      .form-card {
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-2xl);
        box-shadow: var(--shadow-lg);
        border: 1px solid rgba(0, 0, 0, 0.05);
      }
    </style>
</head>

<body style="background-color: var(--background);">
  <%- include('partials/navbar') %>

    <div class="tool-container">
      <div class="text-center mb-5">
        <h1 style="color: var(--primary-dark); margin-bottom: var(--space-sm);">Yield Estimation</h1>
        <p style="color: var(--text-muted);">Predict your annual agricultural outcome based on historical and
          environmental factors.</p>
      </div>

      <div class="form-card">
        <form id="yieldForm">
          <div class="grid grid-cols-2">
            <div class="form-group">
              <label class="form-label">Year of Forecast</label>
              <select name="year" class="form-input" required>
                <option value="" disabled selected>Select Year</option>
                <% for (let y=2024; y <=2030; y++) { %>
                  <option value="<%= y %>">
                    <%= y %>
                  </option>
                  <% } %>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Crop Type</label>
              <select name="item" class="form-input" required>
                <option value="" disabled selected>Select Crop</option>
                <option value="Maize">Maize</option>
                <option value="Potatoes">Potatoes</option>
                <option value="Rice, paddy">Rice</option>
                <option value="Sorghum">Sorghum</option>
                <option value="Soybeans">Soybeans</option>
                <option value="Wheat">Wheat</option>
                <option value="Cassava">Cassava</option>
                <option value="Sweet potatoes">Sweet potatoes</option>
                <option value="Plantains and others">Plantains</option>
                <option value="Yams">Yams</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="form-group">
              <label class="form-label">Avg. Rainfall (mm/year)</label>
              <input type="number" name="average_rain_fall_mm_per_year" class="form-input" placeholder="e.g. 1485"
                required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Pesticides (Tonnes)</label>
              <input type="number" name="pesticides_tonnes" class="form-input" placeholder="e.g. 121" required
                step="any">
            </div>
          </div>

          <div class="grid grid-cols-2">
            <div class="form-group">
              <label class="form-label">Avg. Temperature (°C)</label>
              <input type="number" name="avg_temp" class="form-input" placeholder="e.g. 16.3" required step="any">
            </div>
            <div class="form-group">
              <label class="form-label">Cultivation Area (Acres)</label>
              <input type="number" name="area" class="form-input" placeholder="e.g. 10" required step="any">
            </div>
          </div>

          <div class="text-center mt-4">
            <button type="submit" id="submitBtn" class="btn btn-primary" style="padding: 14px 40px; font-size: 1.1rem;">
              Calculate Estimated Yield 📈
            </button>
            <div style="margin-top: var(--space-md);">
              <a href="/profile" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">Back to
                Dashboard</a>
            </div>
          </div>
        </form>
      </div>

      <!-- Result Overlay -->
      <div id="resultModal"
        style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; justify-content: center; align-items: center; backdrop-filter: blur(8px);">
        <div class="card"
          style="max-width: 500px; width: 90%; text-align: center; padding: var(--space-3xl); animation: zoomIn 0.3s ease-out;">
          <div style="font-size: 4rem; margin-bottom: var(--space-lg);">📊</div>
          <h2 style="color: var(--primary-dark); margin-bottom: var(--space-md);">Harvest Forecast</h2>
          <div
            style="background: var(--background); padding: var(--space-xl); border-radius: var(--radius-lg); margin: var(--space-xl) 0;">
            <span class="text-muted"
              style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px;">Estimated Yield</span>
            <h1 id="yieldValue" style="color: var(--primary); font-size: 3.5rem; margin: 10px 0;">--</h1>
            <span style="font-weight: 600; color: var(--text-muted);">Tonnes / Hectare</span>
          </div>
          <p class="text-muted mb-5">This estimation is based on climatic data telemetry and historical yield patterns
            for your region.</p>
          <button onclick="document.getElementById('resultModal').style.display='none'"
            class="btn btn-primary w-100">Establish New Forecast</button>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="mt-5 grid grid-cols-3" style="gap: var(--space-lg);">
        <div class="card text-center" style="padding: var(--space-md);">
          <div style="font-size: 1.5rem; margin-bottom: 8px;">🌧️</div>
          <h6 style="margin: 0;">Rainfall Impact</h6>
          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Crucial for non-irrigated regions.
          </p>
        </div>
        <div class="card text-center" style="padding: var(--space-md);">
          <div style="font-size: 1.5rem; margin-bottom: 8px;">🧪</div>
          <h6 style="margin: 0;">Pesticide Factor</h6>
          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Balance between protection & soil
            health.</p>
        </div>
        <div class="card text-center" style="padding: var(--space-md);">
          <div style="font-size: 1.5rem; margin-bottom: 8px;">🌡️</div>
          <h6 style="margin: 0;">Temp Consistency</h6>
          <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Stable climate leads to better
            harvest.</p>
        </div>
      </div>
    </div>

    <script>
      document.getElementById('yieldForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<div class="spinner-border spinner-border-sm" role="status"></div> Calculating...';
        btn.disabled = true;

        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('/yield_predict', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data)
          });

          const result = await response.json();

          if (result.error) {
            window.location.href = '/error?details=' + encodeURIComponent(result.details || result.error);
          } else {
            document.getElementById('yieldValue').innerText = parseFloat(result.prediction).toFixed(2);
            document.getElementById('resultModal').style.display = 'flex';
          }
        } catch (error) {
          window.location.href = '/error?details=' + encodeURIComponent(error.message);
        } finally {
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      });
    </script>

    <%- include('partials/footer') %>
</body>

</html>