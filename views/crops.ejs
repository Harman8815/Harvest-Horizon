<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/head') %>
        <style>
            .encyclopedia-hero {
                background: linear-gradient(135deg, var(--primary-dark) 0%, #1a3c1a 100%);
                padding: var(--space-3xl) 0 100px;
                color: white;
                text-align: center;
                position: relative;
                overflow: hidden;
            }

            .hero-pattern {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0.1;
                background-image: radial-gradient(#ffffff 1px, transparent 1px);
                background-size: 30px 30px;
            }

            .hero-blob {
                position: absolute;
                width: 400px;
                height: 400px;
                background: var(--primary);
                filter: blur(80px);
                border-radius: 50%;
                opacity: 0.3;
                z-index: 1;
            }

            .crop-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: var(--space-xl);
                padding-bottom: var(--space-3xl);
            }

            .crop-card {
                background: white;
                border-radius: var(--radius-lg);
                overflow: hidden;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
                transition: var(--transition);
                cursor: pointer;
                border: 1px solid rgba(0, 0, 0, 0.03);
                display: flex;
                flex-direction: column;
            }

            .crop-card:hover {
                transform: translateY(-8px);
                box-shadow: var(--shadow-lg);
                border-color: var(--secondary);
            }

            .crop-card.hidden {
                display: none;
            }

            .image-container {
                height: 220px;
                overflow: hidden;
                position: relative;
            }

            .crop-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .crop-card:hover img {
                transform: scale(1.1);
            }

            .crop-content {
                padding: var(--space-lg);
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }

            .category-tag {
                font-size: 0.7rem;
                color: var(--primary);
                background: #e8f5e9;
                padding: 4px 10px;
                border-radius: 20px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                width: fit-content;
                margin-bottom: 8px;
            }

            .filter-pill {
                padding: 10px 24px;
                border-radius: 50px;
                border: 1px solid #eee;
                background: white;
                color: var(--text-muted);
                font-weight: 600;
                transition: var(--transition);
                cursor: pointer;
                box-shadow: var(--shadow-sm);
            }

            .filter-pill:hover {
                background: #f5f5f5;
            }

            .filter-pill.active {
                background: var(--primary);
                color: white;
                border-color: var(--primary);
                box-shadow: 0 4px 12px rgba(27, 94, 32, 0.3);
            }
        </style>
</head>

<body style="background-color: var(--background);">
    <%- include('partials/navbar') %>

        <div class="encyclopedia-hero">
            <div class="hero-pattern"></div>
            <div class="hero-blob" style="top: -100px; right: -100px;"></div>
            <div class="hero-blob" style="bottom: -100px; left: -100px; background: var(--secondary);"></div>

            <div class="container" style="position: relative; z-index: 2;">
                <span
                    style="text-transform: uppercase; letter-spacing: 3px; font-size: 0.8rem; font-weight: 700; opacity: 0.7;">Botanical
                    Knowledge Base</span>
                <h1 class="display-3 font-bold mt-2" style="color: white; font-family: var(--font-heading);">Crop
                    Encyclopedia</h1>
                <p class="lead mx-auto mb-0" style="max-width: 650px; opacity: 0.8; font-size: 1.1rem;">A comprehensive
                    database of 20+ commercial crops, indexed with optimized cultivation parameters and environmental
                    requirements.</p>
            </div>
        </div>

        <div class="container" style="margin-top: -60px; position: relative; z-index: 10;">
            <!-- Filter Card -->
            <div class="card p-4 mb-5 border-0" style="box-shadow: var(--shadow-lg);">
                <div class="row align-items-center">
                    <div class="col-lg-4 mb-3 mb-lg-0">
                        <div class="d-flex align-items-center px-2">
                            <span style="font-size: 1.2rem; margin-right: 15px;">🔍</span>
                            <input type="text" id="searchInput" class="form-control border-0 p-0"
                                placeholder="Search crops (e.g. Wheat)"
                                style="font-size: 1.1rem; box-shadow: none; font-weight: 500;">
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="d-flex flex-wrap justify-content-lg-end" style="gap: 10px;" id="filterGroup">
                            <button class="filter-pill active" data-filter="all">All Items</button>
                            <button class="filter-pill" data-filter="grains">Grains</button>
                            <button class="filter-pill" data-filter="fruits">Fruits</button>
                            <button class="filter-pill" data-filter="pulses">Pulses</button>
                            <button class="filter-pill" data-filter="fiber">Fiber</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid -->
            <div class="crop-grid" id="cropGrid">
                <% const crops=[ { name: 'Rice' , img: 'rice.webp' , cat: 'grains' }, { name: 'Maize' ,
                    img: 'maize.webp' , cat: 'grains' }, { name: 'Chickpea' , img: 'chickpea.webp' , cat: 'pulses' }, {
                    name: 'Kidneybeans' , img: 'kidneybeans.webp' , cat: 'pulses' }, { name: 'Pigeonpeas' ,
                    img: 'pigeonpeas.jpg' , cat: 'pulses' }, { name: 'Mungbean' , img: 'mungbeans.webp' , cat: 'pulses'
                    }, { name: 'Blackgram' , img: 'blackgram.webp' , cat: 'pulses' }, { name: 'Lentil' ,
                    img: 'lentil.webp' , cat: 'pulses' }, { name: 'Pomegranate' , img: 'pomegranate.webp' ,
                    cat: 'fruits' }, { name: 'Banana' , img: 'banana.webp' , cat: 'fruits' }, { name: 'Mango' ,
                    img: 'mango.webp' , cat: 'fruits' }, { name: 'Grapes' , img: 'grapes.webp' , cat: 'fruits' }, {
                    name: 'Watermelon' , img: 'watermelon.webp' , cat: 'fruits' }, { name: 'Muskmelon' ,
                    img: 'muskmelon.webp' , cat: 'fruits' }, { name: 'Apple' , img: 'apple.webp' , cat: 'fruits' }, {
                    name: 'Orange' , img: 'orange.jpg' , cat: 'fruits' }, { name: 'Papaya' , img: 'papaya.webp' ,
                    cat: 'fruits' }, { name: 'Coconut' , img: 'coconut.webp' , cat: 'fruits' }, { name: 'Cotton' ,
                    img: 'cotton.webp' , cat: 'fiber' }, { name: 'Jute' , img: 'jute.jpg' , cat: 'fiber' }, {
                    name: 'Coffee' , img: 'coffee.webp' , cat: 'beverages' } ]; crops.forEach(crop=> { %>
                    <div class="crop-card" data-name="<%= crop.name.toLowerCase() %>" data-cat="<%= crop.cat %>"
                        onclick="window.location.href='/cropInfo?crop=<%= crop.name.toLowerCase() %>'">
                        <div class="image-container">
                            <img src="img/<%= crop.img %>" alt="<%= crop.name %>" loading="lazy">
                        </div>
                        <div class="crop-content">
                            <div>
                                <span class="category-tag">
                                    <%= crop.cat %>
                                </span>
                                <h4 style="margin: 0; color: var(--primary-dark);">
                                    <%= crop.name %>
                                </h4>
                            </div>
                            <div class="mt-3 pt-3"
                                style="border-top: 1px solid #f5f5f5; display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 500;">View
                                    Profile</span>
                                <span style="color: var(--primary);">→</span>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const searchInput = document.getElementById('searchInput');
                const filterPills = document.querySelectorAll('.filter-pill');
                const cards = document.querySelectorAll('.crop-card');

                function filterCrops() {
                    const searchTerm = searchInput.value.toLowerCase();
                    const activeFilter = document.querySelector('.filter-pill.active').dataset.filter;

                    cards.forEach(card => {
                        const name = card.dataset.name;
                        const cat = card.dataset.cat;
                        const matchesSearch = name.includes(searchTerm);
                        const matchesFilter = activeFilter === 'all' || cat === activeFilter;

                        if (matchesSearch && matchesFilter) {
                            card.style.display = 'flex';
                            gsap.to(card, { opacity: 1, scale: 1, duration: 0.3 });
                        } else {
                            card.style.display = 'none';
                            card.style.opacity = '0';
                        }
                    });
                }

                searchInput.addEventListener('input', filterCrops);

                filterPills.forEach(pill => {
                    pill.addEventListener('click', () => {
                        filterPills.forEach(p => p.classList.remove('active'));
                        pill.classList.add('active');
                        filterCrops();
                    });
                });

                // Initial animation
                gsap.from(".crop-card", {
                    opacity: 0,
                    y: 30,
                    stagger: 0.05,
                    duration: 0.6,
                    ease: "power2.out"
                });
            });
        </script>

        <%- include('partials/footer') %>
</body>

</html>